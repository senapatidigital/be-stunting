{
  "version": 2,
  "builds": [
    {
      "src": "api/nestjs.ts",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/nestjs.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/nestjs.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    }
  ]
}
